<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Import EPC/EAN CSV"
        android:textSize="20sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/pickFileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose CSV File" />

    <Button
        android:id="@+id/resumeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resume Previous Session"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/encodeSingleButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Encode Single EAN"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/summaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/errorsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CC0000" />
    </ScrollView>

    <Button
        android:id="@+id/startWritingButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Writing Tags"
        android:enabled="false" />

</LinearLayout>
